{
  "name": "@origincloud/support",
  "version": "0.11.0",
  "description": "Origin Cloud's support service: support cases, each a conversation between an organization and Origin Cloud support about a question or a problem.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/origincloudhq/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origincloudhq/sdk-typescript.git",
    "directory": "packages/support"
  },
  "bugs": "https://github.com/origincloudhq/sdk-typescript/issues",
  "keywords": [
    "origincloud",
    "origin-cloud",
    "sdk",
    "support"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@origincloud/core": "^0.11.0"
  },
  "devDependencies": {
    "@origincloud/core": "^0.11.0"
  }
}
