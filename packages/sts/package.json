{
  "name": "@origincloud/sts",
  "version": "0.26.0",
  "description": "Origin Cloud's STS service: the security token service: it turns a token from an identity provider outside Origin Cloud, such as a CI job's OIDC token, into the access token of a WORKLOAD service account that trusts it through a federated credential.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/origincloudhq/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origincloudhq/sdk-typescript.git",
    "directory": "packages/sts"
  },
  "bugs": "https://github.com/origincloudhq/sdk-typescript/issues",
  "keywords": [
    "origincloud",
    "origin-cloud",
    "sdk",
    "sts"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@origincloud/core": "^0.26.0"
  },
  "devDependencies": {
    "@origincloud/core": "^0.26.0"
  }
}
